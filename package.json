{
  "name": "saleh-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio website for Saleh Abujazar with a private admin dashboard.",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=server --watch-path=views server/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "setup": "node scripts/init-env.js && npm run seed && npm run create-admin",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "test": "node --test tests/integration.test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299"
  }
}
